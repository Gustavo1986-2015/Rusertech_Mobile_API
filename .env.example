# ---------------------------------------------------------------------
# Rusertech Mobile API — variables de entorno (cargar en Vercel)
# ---------------------------------------------------------------------

# Base de datos: proyecto del SaaS `rudaqsfgjorryuqayqyd` (la base vieja
# `ilhwapmhjzkmaxwwcdbn` se abandonó). Supabase → Connect → Transaction
# pooler (PUERTO 6543). NO usar la conexión directa 5432: serverless abre
# muchas conexiones cortas.
DATABASE_URL=postgresql://postgres.rudaqsfgjorryuqayqyd:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres

# Supabase Storage (solo para las fotos de carga; el resto va por DATABASE_URL)
SUPABASE_URL=https://rudaqsfgjorryuqayqyd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
ATTACHMENTS_BUCKET=cargo-photos

# Notificador de eventos críticos (§4.8)
RESEND_API_KEY=re_xxxx
ALERTS_FROM_EMAIL=alertas@rusertech.com
RUSERTECH_OPS_EMAIL=ops@rusertech.com

# Opcional — solo para tests locales. En producción NO definir.
# RESEND_BASE_URL=https://api.resend.com
